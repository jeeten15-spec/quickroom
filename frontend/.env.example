# Firebase web configuration is public and is used only for Anonymous Auth.
# The frontend never connects to Firebase Realtime Database or Storage.
# Production Pages already falls back to the live QuickRoom Firebase Web app
# if these are omitted at build time. Override them for a different project.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# Production Worker origin. Local Vite proxies /api to the target below.
# For Pages, set this to the deployed Worker (e.g. https://quickroom-api.jeeten15.workers.dev).
VITE_WORKER_URL=http://127.0.0.1:8787

# Google Search Console: paste the verification content value (not the whole tag).
# Search Console → Add property → HTML tag.
VITE_GOOGLE_SITE_VERIFICATION=

# Optional cookieless country reports in the Cloudflare dashboard.
# Cloudflare → Web Analytics → Manage site → copy the beacon token.
VITE_CF_WEB_ANALYTICS_TOKEN=

# Optional Google Analytics 4. In the EEA this loads only after consent.
VITE_GA_MEASUREMENT_ID=

# Google AdSense. Leave empty until the site is approved. Units fill the IAB
# frames (728×90, 160×600, 300×250, 320×50). One slot ID can be reused, or set
# size-specific IDs. Also enable Privacy & messaging (GDPR + US) in AdSense.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
VITE_ADSENSE_SLOT_LEADER=
VITE_ADSENSE_SLOT_SKY=
VITE_ADSENSE_SLOT_BOX=
VITE_ADSENSE_SLOT_MOBILE=
# Set to true after Funding Choices / Privacy & messaging is live, to skip our fallback EU banner.
VITE_GOOGLE_FUNDING_CHOICES=false
