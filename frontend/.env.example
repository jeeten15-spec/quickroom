# Firebase web configuration is public and is used only for Anonymous Auth.
# The frontend never connects to Firebase Realtime Database or Storage.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# Use the deployed Worker origin for Pages. Leave empty to use same-origin /api.
VITE_WORKER_URL=http://127.0.0.1:8787
