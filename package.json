{
  "name": "quickroom",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "worker",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:worker": "npm run dev --workspace=worker",
    "build": "npm run build --workspace=frontend",
    "check": "npm run check --workspace=worker",
    "deploy:worker": "npm run deploy --workspace=worker",
    "deploy:firebase:rules": "firebase deploy --config firebase/firebase.json --only database,storage"
  }
}
